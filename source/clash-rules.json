      "name": "🇺🇸 大流量A",
      "type": "url-test",
      "url": "https://www.gstatic.com/generate_204",
      "interval": 300,
      "tolerance": 50,
      "proxies": [
        "US-A-HY2",
        "US-A-VLESS",
        "US-A-VMess"
      ]
    },
    {
      "name": "🇺🇸 美3",
